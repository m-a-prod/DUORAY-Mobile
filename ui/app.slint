// DUORAY for phones, laid out after the desktop app (DUORAY's
// crates/duoray-gui/ui/app.slint): the same theme palettes, header card,
// server rows and connection card. The desktop sidebar is a drawer here.

import { Palette, Spinner, TextEdit } from "std-widgets.slint";
// Noto Sans, the face the desktop app shows on Linux (OFL, ui/fonts/OFL.txt).
import "fonts/NotoSans-Regular.ttf";
import "fonts/NotoSans-Medium.ttf";
import "fonts/NotoSans-Bold.ttf";
import "fonts/NotoSans-Black.ttf";

export struct SubItem {
    name: string,
    meta: string,
    active: bool,
}

export struct ServerRow {
    flag: image,
    has-flag: bool,
    // ISO code or "··" when there is no flag image.
    badge: string,
    name: string,
    description: string,
    protocol: string,
    transport: string,
    proxies: int,
    edited: bool,
    ping-text: string,
    // 0 none, 1 fast, 2 medium, 3 slow, 4 failed, 5 measuring.
    ping-level: int,
    selected: bool,
    live: bool,
}

export struct SsidRow {
    ssid: string,
    server: string,
}

// One xray core: the bundled one (tag ""), an installed or a downloadable release.
export struct CoreRow {
    tag: string,
    detail: string,
    pre: bool,
    installed: bool,
    selected: bool,
    progress: string,
}

export struct AppRow {
    icon: image,
    has-icon: bool,
    label: string,
    package: string,
    checked: bool,
}

export struct ThemeSwatch {
    name: string,
    bg: color,
    card: color,
    fg: color,
    accent: color,
    active: bool,
}

export global Theme {
    in-out property <float> text-scale: 1.0;
    // "Как в системе": Material colors following the phone's scheme.
    in-out property <bool> follow-system: true;
    out property <bool> system-light: Palette.color-scheme == ColorScheme.light;
    in-out property <bool> c-light;
    in-out property <color> c-bg: #000000;
    in-out property <color> c-card: #0a0a0b;
    in-out property <color> c-fg: #e6e6e6;
    in-out property <color> c-line: #5a5a5e;
    in-out property <color> c-accent: #d0bcff;
    in-out property <color> c-on-accent: #381e72;
    in-out property <color> c-tonal: #2a2a2e;
    in-out property <color> c-on-tonal: #e6e6e6;
    in-out property <color> c-track: #26262a;
    in-out property <color> c-outline: #2c2c30;
    property <bool> sys: follow-system;
    out property <bool> light: sys ? system-light : c-light;
    out property <color> bg: sys ? (system-light ? #f8f3f9 : #1c1b1f) : c-bg;
    out property <color> card: sys ? (system-light ? #ece6f0 : #2a282d) : c-card;
    out property <color> fg: sys ? (system-light ? #1d1b20 : #e6e1e5) : c-fg;
    out property <color> line: sys ? (system-light ? #79747e : #938f99) : c-line;
    out property <color> accent: sys ? (system-light ? #6750a4 : #d0bcff) : c-accent;
    out property <color> on-accent: sys ? (system-light ? #ffffff : #381e72) : c-on-accent;
    out property <color> tonal: sys ? (system-light ? #e8def8 : #4a4458) : c-tonal;
    out property <color> on-tonal: sys ? (system-light ? #1e192b : #e8def8) : c-on-tonal;
    out property <color> track: sys ? (system-light ? #e7e0ec : #36343b) : c-track;
    out property <color> outline: sys ? transparent : c-outline;
    out property <color> muted: fg.with-alpha(0.62);
    out property <color> danger: light ? #ce2c31 : #e5484d;
    out property <color> ok: light ? #218358 : #30a46c;
    out property <color> warn: light ? #ab6400 : #f5a524;
    out property <color> shadow: light ? #0000002e : #00000080;
    out property <length> radius: 12px;
    // The desktop's type scale, a notch up for a phone held at arm's length.
    out property <length> fs-caption: 12px * text-scale;
    out property <length> fs-small: 13px * text-scale;
    out property <length> fs-body: 14px * text-scale;
    out property <length> fs-title: 15px * text-scale;
    out property <length> fs-heading: 19px * text-scale;
    out property <length> fs-display: 23px * text-scale;
}

global Icons {
    out property <image> refresh: @image-url("icons/refresh.svg");
    out property <image> more: @image-url("icons/more.svg");
    out property <image> info: @image-url("icons/info.svg");
    out property <image> send: @image-url("icons/send.svg");
    out property <image> expand-more: @image-url("icons/expand-more.svg");
    out property <image> expand-less: @image-url("icons/expand-less.svg");
    out property <image> sort: @image-url("icons/sort.svg");
    out property <image> add: @image-url("icons/add.svg");
    out property <image> delete: @image-url("icons/delete.svg");
    out property <image> speed: @image-url("icons/speed.svg");
    out property <image> menu: @image-url("icons/menu.svg");
    out property <image> back: @image-url("icons/back.svg");
    out property <image> close: @image-url("icons/close.svg");
    out property <image> wifi: @image-url("icons/wifi.svg");
    out property <image> cellular: @image-url("icons/cellular.svg");
    out property <image> apps: @image-url("icons/apps.svg");
    out property <image> chevron: @image-url("icons/chevron-right.svg");
    out property <image> check: @image-url("icons/check.svg");
    out property <image> logo-off: @image-url("assets/logo-off.svg");
    out property <image> logo-on: @image-url("assets/logo-on.svg");
    out property <image> logo-on-light: @image-url("assets/logo-on-light.svg");
}

// What the app shows; set from Rust (src/app.rs).
export global AppState {
    // Subscriptions with a URL; the hand-added group is shown apart.
    in property <[SubItem]> subs;
    in property <string> manual-meta;
    in property <bool> has-manual;
    in property <bool> manual-selected;
    in property <bool> has-sub;
    in property <string> header-title;
    in property <string> header-meta;
    // "обновлено 05:01 · 78 серверов", beside the actions.
    in property <string> header-short;
    in property <bool> show-usage-row;
    in property <string> usage-text;
    in property <float> usage-fraction: -1;
    in property <string> announce;
    in property <bool> announce-hidden;
    in property <bool> has-web-page;
    in property <bool> has-support;
    in property <string> sub-error;
    in property <bool> busy;
    in property <[ServerRow]> servers;
    in property <int> current-server: -1;
    in property <bool> has-ping-results;
    in property <bool> sort-by-ping;
    in property <bool> pinging;
    in property <bool> show-server-type;
    // Connection: "idle" | "connecting" | "connected" | "failed".
    in property <string> conn-state: "idle";
    in property <string> conn-title: "Не подключено";
    in property <string> conn-detail;
    in property <image> conn-exit-flag;
    in property <string> conn-exit-text;
    in property <string> conn-server;
    in property <string> conn-node;
    in property <string> conn-traffic;
    in property <string> conn-ping-text;
    in property <int> conn-ping-level;
    in property <bool> can-connect;
    in property <string> status;
    // Routing: the server per network.
    in property <bool> policy-enabled;
    in property <string> network-text;
    in property <bool> on-wifi;
    in property <string> current-ssid;
    in property <string> wifi-server;
    in property <string> mobile-server;
    in property <[SsidRow]> ssid-rules;
    // Routing: apps. app-mode 0 all, 1 all but the checked, 2 only the checked.
    in property <int> app-mode;
    in property <int> app-count;
    in property <[AppRow]> apps;
    // Routing: the desktop's simple switches.
    in property <bool> ru-direct;
    in property <bool> whitelist-direct;
    in property <bool> lan-direct: true;
    in property <bool> apps-loading;
    // Settings.
    in property <[ThemeSwatch]> themes;
    in property <int> text-scale: 100;
    // 0 HTTP GET, 1 HTTP HEAD, 2 TCP, 3 ICMP.
    in property <int> ping-mode;
    in property <int> ping-threads: 8;
    in property <int> mobile-ping-threads: 1;
    in property <bool> background-stats: true;
    in property <bool> live-update: true;
    // «Ядро Xray».
    in property <string> core-label;
    in property <[CoreRow]> cores;
    in property <bool> cores-loading;
    in property <string> cores-error;
    // Reading Wi-Fi names: 0 no location access, 1 approximate only,
    // 2 precise but location off, 3 readable.
    in property <int> wifi-access: 3;
    in property <int> ping-timeout: 5000;
    in property <string> ping-url;
    // Identity sent with subscription requests.
    in property <bool> send-device-info: true;
    in property <bool> happ-enabled;
    in property <string> happ-ua;
    in property <string> happ-hwid;
    // 0 Android, 1 iOS, 2 Windows, 3 macOS.
    in property <int> happ-os;
    // The shown subscription's own identity: 0 as in settings, 1 DUORAY, 2 Happ.
    in property <int> sub-id-mode;
    in property <string> sub-hwid;
    in property <string> sub-happ-ua;
    // 0 Default, 1 Double, 2 KeepAlive.
    in property <int> ping-proxy-mode;
    in property <bool> switch-on-select: true;
    in property <bool> autoconnect;
    in property <bool> keep-connected: true;
    in property <string> version;
    in property <string> xray-log;
    in property <string> toast;
    // "Подписка «DUALIZM» заканчивается завтра в 14:00"; empty when none.
    in property <string> expiry-text;
    // A subscription link from duoray://add/..., for the add sheet.
    in property <string> add-prefill;
    // The shown subscription's link as a QR code.
    in property <image> qr-image;
    // Error reports and updates.
    in property <bool> telemetry;
    in property <bool> auto-update;
    in property <string> update-info;
    in property <string> update-banner;
    in property <string> update-detail;
    // 0..1 while downloading, -1 otherwise.
    in property <float> update-progress: -1;
    // Android leaves DUORAY alone in the background (battery optimization off).
    in property <bool> battery-unrestricted: true;
    in property <bool> quiet-notification;
    in property <bool> kill-switch;
    in property <int> failover-secs: 15;
    // «Доступ через хотспот».
    in property <bool> share-enabled;
    in property <bool> share-auth: true;
    in property <string> share-user;
    in property <string> share-pass;
    in property <string> share-addresses;
    in property <bool> local-network: true;
    // The server picker's search: rows that do not match are hidden.
    in property <[bool]> picker-hidden;
    in-out property <bool> consent-open;
    in-out property <bool> report-open;
    in property <string> report-preview;
    in property <string> report-code;
    in property <string> report-error;
    in property <bool> report-busy;
    // The server editor.
    in property <string> edit-name;
    in property <string> edit-meta;
    in property <string> edit-json;
    in-out property <string> edit-error;
    in property <bool> edit-edited;
    in property <bool> expiry-can-renew;
}

// What the UI asks for; handled in Rust.
export global Actions {
    // -1 is the hand-added group.
    callback select-sub(int);
    callback select-server(int);
    callback remove-server(int);
    callback toggle-connection();
    callback refresh();
    callback ping-all();
    callback ping-server(int);
    callback toggle-sort();
    callback toggle-announce();
    callback open-web-page();
    callback open-support();
    callback add-subscription(string);
    callback add-links(string);
    callback remove-subscription();
    callback set-policy-enabled(bool);
    // target: 0 any Wi-Fi, 1 mobile data, 2 the Wi-Fi in use; row -1 clears.
    callback pick-for(int, int);
    callback remove-ssid(int);
    callback ask-wifi-names();
    callback load-apps();
    // which: 0 Russian sites, 1 the mobile whitelist, 2 the local network.
    callback set-direct(int, bool);
    callback set-app-mode(int);
    callback toggle-app(string);
    callback filter-apps(string);
    callback set-theme(int);
    callback set-text-scale(int);
    callback set-ping-mode(int);
    callback set-ping-threads(int);
    callback set-mobile-ping-threads(int);
    callback set-background-stats(bool);
    callback set-live-update(bool);
    callback set-quiet-notification(bool);
    callback set-kill-switch(bool);
    callback request-background();
    callback request-local-network();
    callback filter-picker(string);
    callback set-failover-secs(int);
    callback set-share(bool);
    callback set-share-auth(bool);
    callback new-share-password();
    callback open-cores();
    callback install-core(string);
    callback select-core(string);
    callback remove-core(string);
    // Whether the window takes the system Back (src/platform: predictive back).
    callback back-state(bool);
    callback open-settings(string);
    // The theme is light: Android draws the bar icons dark.
    callback light-bars(bool);
    callback set-ping-timeout(int);
    callback set-ping-url(string);
    callback set-send-device-info(bool);
    callback set-happ(bool);
    callback set-happ-os(int);
    callback happ-new-ids();
    callback happ-new-device();
    callback set-sub-id-mode(int);
    callback set-sub-hwid(string);
    callback sub-random-hwid();
    callback sub-new-happ();
    callback set-ping-proxy-mode(int);
    callback set-switch-on-select(bool);
    callback set-autoconnect(bool);
    callback set-keep-connected(bool);
    callback set-show-server-type(bool);
    callback load-log();
    callback connect-fastest();
    callback show-qr();
    callback consent(bool);
    callback set-telemetry(bool);
    callback set-auto-update(bool);
    callback check-update();
    callback update-clicked();
    callback report-problem();
    callback report-preview(string);
    callback report-send(string);
    callback open-server(int);
    callback save-server(string);
    callback reset-server();
    callback copy-text(string);
    callback scan-qr();
    callback copy-link();
    callback renew();
    callback dismiss-expiry();
    callback buy();
    callback open-url(string);
}

// ── Controls (the desktop's, sized for fingers) ────────────────

component Badge inherits Rectangle {
    in property <string> text;
    border-radius: 7px;
    background: Theme.accent;
    width: 38px;
    height: 26px;
    Text {
        text: root.text;
        color: Theme.on-accent;
        font-size: Theme.fs-small;
        font-weight: 800;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> accent;
    border-radius: 5px;
    border-width: 1px;
    border-color: root.accent ? Theme.accent : Theme.line;
    background: root.accent ? Theme.accent.with-alpha(0.15) : transparent;
    height: 19px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.text;
            font-size: Theme.fs-caption - 1px;
            color: root.accent ? Theme.fg : Theme.muted;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}

component PingChip inherits Rectangle {
    in property <string> text;
    in property <int> level;
    property <color> tone: root.level == 1 ? Theme.ok : root.level == 2 ? Theme.warn : root.level == 3 || root.level == 4 ? Theme.danger : Theme.muted;
    border-radius: 6px;
    height: 22px;
    min-width: 56px;
    horizontal-stretch: 0;
    background: root.tone.with-alpha(0.14);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        alignment: center;
        // Being measured: three dots, still. A spinner would keep the window
        // redrawing at full rate for the whole check.
        Text {
            text: root.level == 5 ? "···" : root.text;
            font-size: Theme.fs-caption;
            font-weight: 700;
            color: root.tone;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component Button inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> primary;
    in property <bool> danger;
    callback clicked();
    property <color> ink: root.primary ? Theme.on-accent : root.danger ? Theme.danger : Theme.on-tonal;
    min-width: max(44px, label.preferred-width + 32px);
    preferred-width: label.preferred-width + 40px;
    height: 44px;
    vertical-stretch: 0;
    border-radius: self.height / 2;
    background: !root.enabled ? Theme.fg.with-alpha(0.12) : root.primary ? Theme.accent : root.danger ? Theme.danger.with-alpha(0.16) : Theme.tonal;
    transform-scale: touch.pressed ? 0.97 : 1;
    animate background { duration: 150ms; easing: ease-out; }
    animate transform-scale { duration: 100ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => {
        root.clicked();
    }
    Rectangle {
        border-radius: parent.border-radius;
        background: root.ink.with-alpha(root.enabled && touch.pressed ? 0.14 : 0);
    }
    label := Text {
        text: root.text;
        color: root.enabled ? root.ink : Theme.fg.with-alpha(0.38);
        font-size: Theme.fs-body;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        accessible-role: none;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <color> tint: Theme.fg;
    in property <bool> enabled: true;
    in property <bool> highlighted;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: root.highlighted ? Theme.accent.with-alpha(0.18) : touch.pressed && root.enabled ? Theme.fg.with-alpha(0.14) : transparent;
    opacity: root.enabled ? 1 : 0.4;
    animate background { duration: 120ms; easing: ease-out; }
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        root.clicked();
    }
    Image {
        source: root.icon;
        accessible-role: none;
        width: 21px;
        height: 21px;
        colorize: root.highlighted ? Theme.accent : root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
}

// The arc turns while a refresh runs (computed points: the software
// renderer ignores rotations).
component RefreshButton inherits Rectangle {
    in property <bool> spinning;
    callback clicked();
    width: 40px;
    height: 40px;
    border-radius: 20px;
    background: touch.pressed && !root.spinning ? Theme.fg.with-alpha(0.14) : transparent;
    if !root.spinning: Image {
        source: Icons.refresh;
        width: 21px;
        height: 21px;
        colorize: Theme.fg;
    }
    if root.spinning: Path {
        property <angle> a: mod(animation-tick() / 1ms, 1000) * 0.36deg;
        width: 21px;
        height: 21px;
        viewbox-width: 24;
        viewbox-height: 24;
        stroke: Theme.fg;
        stroke-width: 2.2px;
        stroke-line-cap: round;
        MoveTo {
            x: 12 + 8 * cos(a);
            y: 12 + 8 * sin(a);
        }
        ArcTo {
            x: 12 + 8 * cos(a + 270deg);
            y: 12 + 8 * sin(a + 270deg);
            radius-x: 8;
            radius-y: 8;
            large-arc: true;
            sweep: true;
        }
    }
    touch := TouchArea {
        enabled: !root.spinning;
        clicked => {
            root.clicked();
        }
    }
}

component Switch inherits Rectangle {
    in-out property <bool> checked;
    callback toggled();
    property <length> knob: touch.pressed ? 28px : root.checked ? 24px : 16px;
    width: 52px;
    height: 32px;
    border-radius: 16px;
    border-width: 2px;
    border-color: root.checked ? Theme.accent : Theme.line;
    background: root.checked ? Theme.accent : Theme.track;
    animate background, border-color { duration: 160ms; easing: ease-out; }
    accessible-role: switch;
    accessible-checkable: true;
    accessible-checked: root.checked;
    Rectangle {
        width: root.knob;
        height: root.knob;
        x: root.checked ? parent.width - root.knob - 4px : touch.pressed ? 2px : 8px;
        y: (parent.height - self.height) / 2;
        border-radius: self.width / 2;
        background: root.checked ? Theme.on-accent : Theme.line;
        animate x, width, height, background { duration: 180ms; easing: ease-out; }
    }
    touch := TouchArea {
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
}

component Card inherits Rectangle {
    background: Theme.card;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.outline;
}

component SectionLabel inherits Text {
    font-size: Theme.fs-caption;
    font-weight: 700;
    color: Theme.muted;
    letter-spacing: 0.6px;
}

component Divider inherits Rectangle {
    height: 1px;
    background: Theme.line.with-alpha(0.35);
}

// A settings row: title and hint on the left, a switch on the right.
component ToggleRow inherits HorizontalLayout {
    in property <string> title;
    in property <string> hint;
    in-out property <bool> checked;
    callback toggled(bool);
    spacing: 12px;
    VerticalLayout {
        horizontal-stretch: 1;
        alignment: center;
        spacing: 2px;
        Text {
            text: root.title;
            font-size: Theme.fs-body;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.hint != "": Text {
            text: root.hint;
            font-size: Theme.fs-caption;
            color: Theme.muted;
            wrap: word-wrap;
        }
    }
    VerticalLayout {
        alignment: center;
        Switch {
            checked <=> root.checked;
            toggled => {
                root.toggled(self.checked);
            }
        }
    }
}

// One choice of a segmented row.
component Segment inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 38px;
    horizontal-stretch: 1;
    border-radius: 9px;
    background: root.active ? Theme.tonal : touch.pressed ? Theme.fg.with-alpha(0.06) : transparent;
    animate background { duration: 150ms; }
    Text {
        text: root.text;
        font-size: Theme.fs-small;
        font-weight: root.active ? 700 : 500;
        color: root.active ? Theme.on-tonal : Theme.fg;
        overflow: elide;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// − value + stepper for small numbers (threads, timeout).
component Stepper inherits HorizontalLayout {
    in property <string> title;
    in property <string> value;
    callback minus();
    callback plus();
    spacing: 4px;
    // Wraps on narrow screens instead of pushing the buttons off the edge.
    Text {
        text: root.title;
        font-size: Theme.fs-body;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
    Button {
        text: "−";
        width: 44px;
        clicked => {
            root.minus();
        }
    }
    Text {
        text: root.value;
        font-size: Theme.fs-body;
        min-width: 52px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Button {
        text: "+";
        width: 44px;
        clicked => {
            root.plus();
        }
    }
}

component PageHeader inherits HorizontalLayout {
    in property <string> text;
    callback back();
    padding-left: 4px;
    padding-right: 16px;
    padding-top: 4px;
    padding-bottom: 4px;
    spacing: 4px;
    IconButton {
        icon: Icons.back;
                        label: "Назад";
        clicked => {
            root.back();
        }
    }
    Text {
        text: root.text;
        font-size: Theme.fs-heading;
        font-weight: 800;
        vertical-alignment: center;
    }
}

// ── Servers ────────────────────────────────────────────────────

component ServerItem inherits Rectangle {
    in property <ServerRow> server;
    in property <bool> show-selection: true;
    in property <bool> manual;
    callback clicked();
    callback long-pressed();
    callback remove();
    callback open();
    property <bool> marked: root.show-selection && root.server.selected;
    // Inside the subscription card: a radio shows the choice, no fill.
    in property <bool> radio;
    // A hold pings the server (as in Material Xray); the release after it is no tap.
    property <bool> held;
    height: 58px * Theme.text-scale;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.fg.with-alpha(0.06) : root.marked && !root.radio ? Theme.tonal : transparent;
    animate background { duration: 120ms; easing: ease-out; }
    touch := TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.held = false;
            }
        }
        clicked => {
            if (!root.held) {
                root.clicked();
            }
            root.held = false;
        }
    }
    Timer {
        interval: 450ms;
        running: touch.pressed && !root.held;
        triggered => {
            root.held = true;
            root.long-pressed();
        }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 12px;
        if root.radio: VerticalLayout {
            alignment: center;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: root.server.selected ? Theme.accent : Theme.line;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.accent;
                    opacity: root.server.selected ? 1 : 0;
                    animate opacity { duration: 120ms; }
                }
            }
        }
        VerticalLayout {
            alignment: center;
            if root.server.has-flag: Image {
                source: root.server.flag;
                width: 30px;
                height: 30px;
                image-fit: contain;
            }
            if !root.server.has-flag: Badge {
                text: root.server.badge;
            }
        }
        VerticalLayout {
            alignment: center;
            spacing: 3px;
            horizontal-stretch: 1;
            Text {
                text: root.server.name;
                font-size: Theme.fs-title;
                font-weight: 600;
                color: root.marked && !root.radio ? Theme.on-tonal : Theme.fg;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 6px;
                if root.server.edited: Chip {
                    text: "изменён";
                    accent: true;
                }
                if root.server.proxies > 1: Chip {
                    text: "авто × " + root.server.proxies;
                }
                if AppState.show-server-type: Chip {
                    text: root.server.protocol;
                }
                Text {
                    text: root.server.description;
                    font-size: Theme.fs-caption;
                    color: root.marked ? Theme.on-tonal.with-alpha(0.7) : Theme.muted;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }
        // Last, in a column of its own: pings line up down the list.
        if root.server.ping-level != 0: VerticalLayout {
            alignment: center;
            PingChip {
                text: root.server.ping-text;
                level: root.server.ping-level;
                width: 62px * Theme.text-scale;
            }
        }
        if root.radio: Rectangle {
            width: 28px;
            Image {
                source: Icons.chevron;
                width: 20px;
                height: 20px;
                colorize: Theme.muted;
            }
            TouchArea {
                clicked => {
                    root.open();
                }
            }
        }
        if root.manual: VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                        label: "Удалить";
                tint: Theme.danger;
                clicked => {
                    root.remove();
                }
            }
        }
    }
}

// Subscription card: the desktop header's content, compact for a phone.
// The announcement starts folded.
component HeaderCard inherits Card {
    in-out property <bool> show-announce;
    // The chips above already name the subscription.
    in property <bool> show-title: true;
    callback more-clicked();
    VerticalLayout {
        padding: 8px;
        padding-left: 14px;
        padding-right: 4px;
        spacing: 4px;
        HorizontalLayout {
            if root.show-title: Text {
                text: AppState.header-title;
                font-size: Theme.fs-title + 2px;
                font-weight: 800;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if !root.show-title: Text {
                text: AppState.header-short;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if !AppState.manual-selected: VerticalLayout {
                alignment: center;
                RefreshButton {
                    spinning: AppState.busy;
                    clicked => {
                        Actions.refresh();
                    }
                }
            }
            if AppState.has-ping-results: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.sort;
                        label: "Сортировать по задержке";
                    highlighted: AppState.sort-by-ping;
                    clicked => {
                        Actions.toggle-sort();
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                // While a check runs it stops it.
                IconButton {
                    icon: AppState.pinging ? Icons.close : Icons.speed;
                    label: AppState.pinging ? "Остановить проверку" : "Проверить задержку";
                    clicked => {
                        Actions.ping-all();
                    }
                }
            }
            if AppState.announce != "": VerticalLayout {
                alignment: center;
                IconButton {
                    icon: root.show-announce ? Icons.expand-less : Icons.expand-more;
                    clicked => {
                        root.show-announce = !root.show-announce;
                    }
                }
            }
            if !AppState.manual-selected: VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.more;
                        label: "Действия с подпиской";
                    clicked => {
                        root.more-clicked();
                    }
                }
            }
        }
        if root.show-title: HorizontalLayout {
            padding-right: 10px;
            Text {
                text: AppState.header-short;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if AppState.show-usage-row: HorizontalLayout {
            padding-right: 4px;
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.info;
                        label: "Страница подписки";
                    tint: Theme.accent;
                    enabled: AppState.has-web-page;
                    clicked => {
                        Actions.open-web-page();
                    }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                height: 20px;
                y: (parent.height - self.height) / 2;
                if AppState.usage-fraction > 0: Rectangle {
                    x: 0;
                    width: max(self.height, parent.width * min(1, AppState.usage-fraction));
                    border-radius: self.height / 2;
                    background: AppState.usage-fraction > 0.9 ? Theme.danger.with-alpha(0.7) : Theme.accent.with-alpha(0.55);
                }
                Rectangle {
                    border-radius: self.height / 2;
                    border-width: 1px;
                    border-color: Theme.line;
                }
                Text {
                    text: AppState.usage-text;
                    font-size: Theme.fs-caption;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            VerticalLayout {
                alignment: center;
                IconButton {
                    icon: Icons.send;
                        label: "Поддержка";
                    tint: #2aabee;
                    enabled: AppState.has-support;
                    clicked => {
                        Actions.open-support();
                    }
                }
            }
        }
        if AppState.sub-error != "": Text {
            text: AppState.sub-error;
            font-size: Theme.fs-caption;
            color: Theme.danger;
            wrap: word-wrap;
            max-height: 34px;
            overflow: elide;
        }
        if root.show-announce && AppState.announce != "": Text {
            text: AppState.announce;
            font-size: Theme.fs-caption;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
}

// The desktop's connection card, floating over the list: status (or,
// connected, the exit country with its flag, the server and the traffic)
// on the left, the button on the right.
component ConnectionCard inherits Rectangle {
    property <string> state: AppState.conn-state;
    property <bool> on: root.state == "connected";
    property <bool> has-exit: root.on && AppState.conn-exit-text != "";
    property <color> tone: root.on ? Theme.ok : root.state == "failed" || root.state == "blocked" ? Theme.danger : root.state == "idle" ? Theme.line : Theme.warn;
    border-radius: 20px;
    background: Theme.card.with-alpha(0.97);
    border-width: 1px;
    border-color: Theme.outline.with-alpha(0.9);
    drop-shadow-blur: 18px;
    drop-shadow-offset-y: 4px;
    drop-shadow-color: Theme.shadow;
    // Sized by its content: a floating element would otherwise fill the window.
    height: card-row.preferred-height;
    card-row := HorizontalLayout {
        padding: 10px;
        padding-left: 14px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            if root.has-exit: Image {
                source: AppState.conn-exit-flag;
                width: 30px;
                height: 30px;
                image-fit: contain;
            }
            if !root.has-exit: Rectangle {
                width: 18px;
                height: 18px;
                Rectangle {
                    width: parent.width;
                    height: parent.height;
                    border-radius: self.height / 2;
                    background: root.tone.with-alpha(0.25);
                    opacity: root.state == "connecting" ? 0.5 + 0.5 * sin(mod(animation-tick() / 1ms, 1400) / 1400 * 360deg) : root.on ? 1 : 0;
                }
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: root.tone;
                    animate background { duration: 200ms; easing: ease-out; }
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text {
                text: root.has-exit ? AppState.conn-exit-text : AppState.conn-title;
                font-size: Theme.fs-title;
                font-weight: 700;
                color: root.on && !root.has-exit ? Theme.ok : Theme.fg;
                overflow: elide;
            }
            // No empty line under the title: it would sit above the button's middle.
            if (root.on ? AppState.conn-server : AppState.conn-detail) != "": Text {
                text: root.on ? AppState.conn-server + (AppState.conn-ping-text != "" ? " · " + AppState.conn-ping-text : "") : AppState.conn-detail;
                font-size: Theme.fs-caption;
                color: root.state == "failed" || root.state == "blocked" ? Theme.danger : Theme.muted;
                overflow: elide;
            }
            if root.on && AppState.conn-traffic != "": Text {
                text: AppState.conn-traffic;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            Button {
                height: 40px;
                preferred-width: self.min-width;
                text: root.on || root.state == "blocked" ? "Отключить" : root.state == "connecting" ? "Отменить" : "Подключить";
                primary: !root.on && root.state != "blocked";
                enabled: root.on || root.state == "connecting" || root.state == "blocked" || AppState.can-connect;
                clicked => {
                    Actions.toggle-connection();
                }
            }
        }
    }
}

component EmptyServers inherits VerticalLayout {
    callback add-clicked();
    alignment: center;
    padding: 32px;
    spacing: 12px;
    HorizontalLayout {
        alignment: center;
        Image {
            source: Icons.logo-off;
            width: 72px;
            height: 60px;
        }
    }
    Text {
        text: "Добавьте подписку";
        font-size: Theme.fs-heading;
        font-weight: 800;
        horizontal-alignment: center;
    }
    Text {
        text: "Ссылка на подписку или ключи vless://, vmess://, trojan://, ss://, hysteria2://";
        font-size: Theme.fs-small;
        color: Theme.muted;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    HorizontalLayout {
        alignment: center;
        Button {
            text: "Добавить подписку";
            primary: true;
            clicked => {
                root.add-clicked();
            }
        }
    }
    HorizontalLayout {
        alignment: center;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            Text {
                text: "Нет подписки?";
                font-size: Theme.fs-body;
                color: Theme.muted;
            }
        }
        Button {
            text: "Купить";
            clicked => {
                Actions.buy();
            }
        }
    }
}

// ── Subscription chips ─────────────────────────────────────────

component Chips inherits Flickable {
    height: 44px;
    content-width: max(self.width, chips.preferred-width);
    chips := HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 8px;
        alignment: start;
        for sub[i] in AppState.subs: Rectangle {
            height: 34px;
            y: 5px;
            width: chip-text.preferred-width + 26px;
            border-radius: 17px;
            background: sub.active ? Theme.tonal : transparent;
            border-width: sub.active ? 0 : 1px;
            border-color: Theme.line.with-alpha(0.6);
            chip-text := Text {
                text: sub.name;
                font-size: Theme.fs-small;
                font-weight: sub.active ? 700 : 500;
                color: sub.active ? Theme.on-tonal : Theme.fg;
            }
            TouchArea {
                clicked => {
                    Actions.select-sub(i);
                }
            }
        }
        if AppState.has-manual: Rectangle {
            height: 34px;
            y: 5px;
            width: manual-text.preferred-width + 26px;
            border-radius: 17px;
            background: AppState.manual-selected ? Theme.tonal : transparent;
            border-width: AppState.manual-selected ? 0 : 1px;
            border-color: Theme.line.with-alpha(0.6);
            manual-text := Text {
                text: "Мои серверы";
                font-size: Theme.fs-small;
                font-weight: AppState.manual-selected ? 700 : 500;
                color: AppState.manual-selected ? Theme.on-tonal : Theme.fg;
            }
            TouchArea {
                clicked => {
                    Actions.select-sub(-1);
                }
            }
        }
    }
}

component PageTitle inherits HorizontalLayout {
    in property <string> text;
    padding-left: 18px;
    padding-top: 10px;
    padding-bottom: 6px;
    Text {
        text: root.text;
        font-size: Theme.fs-heading;
        font-weight: 800;
    }
}

component NavItem inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 1;
    VerticalLayout {
        alignment: center;
        spacing: 3px;
        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 60px;
                height: 30px;
                border-radius: 15px;
                background: root.active ? Theme.tonal : transparent;
                animate background { duration: 150ms; easing: ease-out; }
                Image {
                    source: root.icon;
                    width: 21px;
                    height: 21px;
                    colorize: root.active ? Theme.on-tonal : Theme.muted;
                }
            }
        }
        Text {
            text: root.text;
            font-size: Theme.fs-caption;
            font-weight: root.active ? 700 : 500;
            color: root.active ? Theme.fg : Theme.muted;
            horizontal-alignment: center;
        }
    }
    TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// ── Routing ────────────────────────────────────────────────────

component ChoiceRow inherits Rectangle {
    in property <image> icon;
    in property <string> title;
    in property <string> value;
    in property <bool> enabled: true;
    callback clicked();
    min-height: 68px;
    background: touch.pressed && root.enabled ? Theme.fg.with-alpha(0.06) : transparent;
    opacity: root.enabled ? 1 : 0.45;
    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 6px;
        padding-top: 12px;
        padding-bottom: 12px;
        spacing: 14px;
        Image {
            source: root.icon;
            width: 21px;
            colorize: Theme.accent;
            vertical-alignment: center;
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: root.title;
                font-size: Theme.fs-body;
                font-weight: 600;
            }
            Text {
                text: root.value;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
        }
        Image {
            source: Icons.chevron;
            width: 21px;
            colorize: Theme.muted;
            vertical-alignment: center;
        }
    }
}

component RoutingPage inherits Rectangle {
    in property <length> bottom-inset;
    callback pick(int);
    callback open-apps();
    background: Theme.bg;
    VerticalLayout {
        PageTitle {
            text: "Маршрутизация";
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: 12px;
                padding-top: 4px;
                padding-bottom: root.bottom-inset + 12px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 6px;
                    SectionLabel {
                        text: "НАПРЯМУЮ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 14px;
                        ToggleRow {
                            title: "Российские сайты";
                            hint: "Все российские IP-адреса и сайты .ru, .рф, .su: Госуслуги, банки, маркетплейсы, видео. Они видят вас как обычно и работают быстрее. На мобильном интернете с белыми списками операторов сайты не из списка напрямую не откроются: там включайте «Белый список».";
                            checked: AppState.ru-direct;
                            toggled(on) => {
                                Actions.set-direct(0, on);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            title: "Белый список";
                            hint: "Только сайты из белых списков мобильных операторов: те, что открываются даже при ограничениях мобильного интернета. Остальные российские сайты пойдут через VPN.";
                            checked: AppState.whitelist-direct;
                            toggled(on) => {
                                Actions.set-direct(1, on);
                            }
                        }
                        Divider { }
                        ToggleRow {
                            title: "Локальная сеть";
                            hint: "Роутер, принтеры, NAS и другие устройства дома или в офисе.";
                            checked: AppState.lan-direct;
                            toggled(on) => {
                                Actions.set-direct(2, on);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ПРИЛОЖЕНИЯ";
                    }
                }
                Card {
                    ChoiceRow {
                        icon: Icons.apps;
                        title: AppState.app-mode == 0 ? "Все приложения через VPN" : AppState.app-mode == 1 ? "Все, кроме выбранных" : "Только выбранные";
                        value: AppState.app-mode == 0 ? "Можно исключить банки и другие приложения" : "Выбрано: " + AppState.app-count;
                        clicked => {
                            root.open-apps();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "СЕРВЕР ПО СЕТИ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 8px;
                        ToggleRow {
                            title: "Свой сервер для Wi-Fi и мобильной сети";
                            hint: "При смене сети подключение само переходит на выбранный для неё сервер.";
                            checked: AppState.policy-enabled;
                            toggled(on) => {
                                Actions.set-policy-enabled(on);
                            }
                        }
                        Text {
                            text: "Сейчас: " + AppState.network-text;
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                        }
                    }
                }
                Card {
                    VerticalLayout {
                        ChoiceRow {
                            icon: Icons.wifi;
                            title: "Любая Wi-Fi сеть";
                            value: AppState.wifi-server;
                            enabled: AppState.policy-enabled;
                            clicked => {
                                root.pick(0);
                            }
                        }
                        Divider { }
                        ChoiceRow {
                            icon: Icons.cellular;
                            title: "Мобильная сеть";
                            value: AppState.mobile-server;
                            enabled: AppState.policy-enabled;
                            clicked => {
                                root.pick(1);
                            }
                        }
                        for rule[i] in AppState.ssid-rules: VerticalLayout {
                            Divider { }
                            HorizontalLayout {
                                height: 58px;
                                padding-left: 14px;
                                padding-right: 2px;
                                spacing: 14px;
                                Image {
                                    source: Icons.wifi;
                                    width: 21px;
                                    colorize: Theme.accent;
                                    vertical-alignment: center;
                                }
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 2px;
                                    Text {
                                        text: "«" + rule.ssid + "»";
                                        font-size: Theme.fs-body;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: rule.server;
                                        font-size: Theme.fs-caption;
                                        color: Theme.muted;
                                        overflow: elide;
                                    }
                                }
                                VerticalLayout {
                                    alignment: center;
                                    IconButton {
                                        icon: Icons.delete;
                        label: "Удалить";
                                        tint: Theme.muted;
                                        clicked => {
                                            Actions.remove-ssid(i);
                                        }
                                    }
                                }
                            }
                        }
                        Divider { }
                        VerticalLayout {
                            padding: 12px;
                            spacing: 8px;
                            if AppState.current-ssid != "": Button {
                                text: "Сервер для «" + AppState.current-ssid + "»";
                                enabled: AppState.policy-enabled;
                                clicked => {
                                    root.pick(2);
                                }
                            }
                            if AppState.current-ssid == "" && AppState.on-wifi: Text {
                                text: AppState.wifi-access == 0 ? "Android показывает название Wi-Fi только приложениям с доступом к местоположению." : AppState.wifi-access == 1 ? "Нужен точный доступ к местоположению: с приблизительным Android скрывает название Wi-Fi. Включите «Точное местоположение» для DUORAY." : AppState.wifi-access == 2 ? "Включите геолокацию: пока она выключена, Android скрывает название Wi-Fi." : "Название сети пока не получено.";
                                font-size: Theme.fs-caption;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            if AppState.current-ssid == "" && AppState.on-wifi && AppState.wifi-access == 0: Button {
                                text: "Разрешить";
                                clicked => {
                                    Actions.ask-wifi-names();
                                }
                            }
                            if AppState.current-ssid == "" && AppState.on-wifi && AppState.wifi-access == 1: Button {
                                text: "Открыть настройки";
                                clicked => {
                                    Actions.open-settings("app");
                                }
                            }
                            if AppState.current-ssid == "" && AppState.on-wifi && AppState.wifi-access == 2: Button {
                                text: "Включить геолокацию";
                                clicked => {
                                    Actions.open-settings("location");
                                }
                            }
                            if !AppState.on-wifi: Text {
                                text: "Для отдельной Wi-Fi сети подключитесь к ней: здесь появится кнопка выбора сервера.";
                                font-size: Theme.fs-caption;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}

component AppsPage inherits Rectangle {
    in property <length> bottom-inset;
    callback back();
    background: Theme.bg;
    TouchArea { }
    VerticalLayout {
        PageHeader {
            text: "Приложения";
            back => {
                root.back();
            }
        }
        VerticalLayout {
            vertical-stretch: 0;
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 6px;
            spacing: 8px;
            Card {
                HorizontalLayout {
                    padding: 4px;
                    spacing: 4px;
                    Segment {
                        text: "Все";
                        active: AppState.app-mode == 0;
                        clicked => {
                            Actions.set-app-mode(0);
                        }
                    }
                    Segment {
                        text: "Кроме выбранных";
                        active: AppState.app-mode == 1;
                        clicked => {
                            Actions.set-app-mode(1);
                        }
                    }
                    Segment {
                        text: "Только выбранные";
                        active: AppState.app-mode == 2;
                        clicked => {
                            Actions.set-app-mode(2);
                        }
                    }
                }
            }
            Text {
                text: AppState.app-mode == 0 ? "Все приложения идут через VPN. Выберите режим, чтобы исключить или оставить отдельные." : AppState.app-mode == 1 ? "Отмеченные приложения идут напрямую, мимо VPN." : "Через VPN идут только отмеченные приложения.";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Rectangle {
                height: 42px;
                border-radius: 21px;
                background: Theme.card;
                border-width: 1px;
                border-color: search.has-focus ? Theme.accent : Theme.outline;
                search := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: Theme.fs-body;
                    color: Theme.fg;
                    single-line: true;
                    edited => {
                        Actions.filter-apps(self.text);
                    }
                }
                if search.text == "": Text {
                    x: 16px;
                    text: "Поиск приложения";
                    font-size: Theme.fs-body;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
        }
        if AppState.apps-loading: VerticalLayout {
            vertical-stretch: 1;
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Spinner {
                    indeterminate: true;
                    width: 32px;
                    height: 32px;
                }
            }
        }
        if !AppState.apps-loading: Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: app-list.preferred-height;
            app-list := VerticalLayout {
                alignment: start;
                for app in AppState.apps: Rectangle {
                    height: 60px;
                    opacity: AppState.app-mode == 0 ? 0.5 : 1;
                    background: app-touch.pressed ? Theme.fg.with-alpha(0.06) : transparent;
                    app-touch := TouchArea {
                        enabled: AppState.app-mode != 0;
                        clicked => {
                            Actions.toggle-app(app.package);
                        }
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 14px;
                        VerticalLayout {
                            alignment: center;
                            if app.has-icon: Image {
                                source: app.icon;
                                width: 36px;
                                height: 36px;
                            }
                            if !app.has-icon: Rectangle {
                                width: 36px;
                                height: 36px;
                                border-radius: 10px;
                                background: Theme.track;
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 1px;
                            Text {
                                text: app.label;
                                font-size: Theme.fs-body;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: app.package;
                                font-size: Theme.fs-caption;
                                color: Theme.muted;
                                overflow: elide;
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            Rectangle {
                                width: 24px;
                                height: 24px;
                                border-radius: 6px;
                                border-width: app.checked ? 0 : 2px;
                                border-color: Theme.line;
                                background: app.checked ? Theme.accent : transparent;
                                if app.checked: Image {
                                    source: Icons.check;
                                    width: 18px;
                                    height: 18px;
                                    colorize: Theme.on-accent;
                                }
                            }
                        }
                    }
                }
        
            }
        }
        Rectangle {
            height: root.bottom-inset;
        }
    }
}

// ── Settings ───────────────────────────────────────────────────

component ThemeTile inherits Rectangle {
    in property <ThemeSwatch> swatch;
    callback clicked();
    height: 64px;
    border-radius: 10px;
    border-width: root.swatch.active ? 2px : 1px;
    border-color: root.swatch.active ? Theme.accent : Theme.line.with-alpha(0.5);
    background: root.swatch.bg;
    clip: true;
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    Rectangle {
        x: 8px;
        y: 8px;
        width: parent.width - 16px;
        height: 22px;
        border-radius: 6px;
        background: root.swatch.card;
        Rectangle {
            x: parent.width - 18px;
            width: 10px;
            height: 10px;
            border-radius: 5px;
            background: root.swatch.accent;
        }
    }
    Text {
        x: 8px;
        y: parent.height - self.height - 7px;
        width: parent.width - 16px;
        text: root.swatch.name;
        font-size: Theme.fs-caption;
        font-weight: 600;
        color: root.swatch.fg;
        overflow: elide;
    }
}

component SettingsPage inherits Rectangle {
    in property <length> bottom-inset;
    callback cores();
    background: Theme.bg;
    VerticalLayout {
        PageTitle {
            text: "Настройки";
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: content.preferred-height;
            content := VerticalLayout {
                padding: 12px;
                padding-top: 4px;
                padding-bottom: root.bottom-inset + 12px;
                spacing: 10px;
                alignment: start;
                HorizontalLayout {
                    padding-left: 6px;
                    SectionLabel {
                        text: "ОФОРМЛЕНИЕ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 12px;
                        // Two tiles a row.
                        for row in (AppState.themes.length + 1) / 2: HorizontalLayout {
                            spacing: 8px;
                            ThemeTile {
                                horizontal-stretch: 1;
                                swatch: AppState.themes[row * 2];
                                clicked => {
                                    Actions.set-theme(row * 2);
                                }
                            }
                            if row * 2 + 1 < AppState.themes.length: ThemeTile {
                                horizontal-stretch: 1;
                                swatch: AppState.themes[row * 2 + 1];
                                clicked => {
                                    Actions.set-theme(row * 2 + 1);
                                }
                            }
                            if row * 2 + 1 >= AppState.themes.length: Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        Stepper {
                            title: "Размер текста";
                            value: AppState.text-scale + " %";
                            minus => {
                                Actions.set-text-scale(AppState.text-scale - 10);
                            }
                            plus => {
                                Actions.set-text-scale(AppState.text-scale + 10);
                            }
                        }
                        ToggleRow {
                            title: "Показывать тип сервера";
                            checked: AppState.show-server-type;
                            toggled(on) => {
                                Actions.set-show-server-type(on);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ПОДПИСКИ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        ToggleRow {
                            title: "Отправлять HWID и данные устройства";
                            hint: "Заголовки x-hwid, ОС и модель. Нужны панелям с лимитом устройств. Если выключить, уходит только User-Agent.";
                            checked: AppState.send-device-info;
                            toggled(on) => {
                                Actions.set-send-device-info(on);
                            }
                        }
                        ToggleRow {
                            title: "Happ Spoof";
                            hint: "Представляться клиентом Happ — для панелей, которые отдают подписку только ему. По умолчанию DUORAY представляется собой.";
                            checked: AppState.happ-enabled;
                            toggled(on) => {
                                Actions.set-happ(on);
                            }
                        }
                        // Flat `if`s: Slint under-measures wrapped text in a
                        // conditional sub-layout.
                        if AppState.happ-enabled: HorizontalLayout {
                            spacing: 4px;
                            for os[i] in ["Android", "iOS", "Windows", "macOS"]: Segment {
                                text: os;
                                active: AppState.happ-os == i;
                                clicked => {
                                    Actions.set-happ-os(i);
                                }
                            }
                        }
                        if AppState.happ-enabled: Text {
                            text: AppState.happ-ua + "\nHWID " + AppState.happ-hwid;
                            font-family: "monospace";
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: char-wrap;
                        }
                        if AppState.happ-enabled: HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Новые ID";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.happ-new-ids();
                                }
                            }
                            Button {
                                text: "Другое устройство";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.happ-new-device();
                                }
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ПИНГ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 4px;
                            Segment {
                                text: "HTTP GET";
                                active: AppState.ping-mode == 0;
                                clicked => {
                                    Actions.set-ping-mode(0);
                                }
                            }
                            Segment {
                                text: "HEAD";
                                active: AppState.ping-mode == 1;
                                clicked => {
                                    Actions.set-ping-mode(1);
                                }
                            }
                            Segment {
                                text: "TCP";
                                active: AppState.ping-mode == 2;
                                clicked => {
                                    Actions.set-ping-mode(2);
                                }
                            }
                            Segment {
                                text: "ICMP";
                                active: AppState.ping-mode == 3;
                                clicked => {
                                    Actions.set-ping-mode(3);
                                }
                            }
                        }
                        Text {
                            text: AppState.ping-mode <= 1 ? "Настоящая задержка: запрос через сам сервер. Сервер, который сеть не пропускает, покажет «—»." : "Только до сервера: заблокированный сервер может показать хорошее время.";
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        // Flat `if`s, as in the Happ block above.
                        if AppState.ping-mode <= 1: Text {
                            text: "Адрес проверки";
                            font-size: Theme.fs-body;
                            font-weight: 600;
                        }
                        if AppState.ping-mode <= 1: Rectangle {
                            height: 42px;
                            border-radius: 10px;
                            background: Theme.bg;
                            border-width: url-input.has-focus ? 2px : 1px;
                            border-color: url-input.has-focus ? Theme.accent : Theme.line;
                            url-input := TextInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: parent.height;
                                vertical-alignment: center;
                                single-line: true;
                                text: AppState.ping-url;
                                font-size: Theme.fs-small;
                                color: Theme.fg;
                                accepted => {
                                    Actions.set-ping-url(self.text);
                                }
                                edited => {
                                    Actions.set-ping-url(self.text);
                                }
                            }
                        }
                        if AppState.ping-mode <= 1: Text {
                            text: "Режим";
                            font-size: Theme.fs-body;
                            font-weight: 600;
                        }
                        if AppState.ping-mode <= 1: HorizontalLayout {
                            spacing: 4px;
                            Segment {
                                text: "Default";
                                active: AppState.ping-proxy-mode == 0;
                                clicked => {
                                    Actions.set-ping-proxy-mode(0);
                                }
                            }
                            Segment {
                                text: "Double";
                                active: AppState.ping-proxy-mode == 1;
                                clicked => {
                                    Actions.set-ping-proxy-mode(1);
                                }
                            }
                            Segment {
                                text: "KeepAlive";
                                active: AppState.ping-proxy-mode == 2;
                                clicked => {
                                    Actions.set-ping-proxy-mode(2);
                                }
                            }
                        }
                        if AppState.ping-mode <= 1: Text {
                            text: AppState.ping-proxy-mode == 0 ? "Default: один запрос, включая установку соединения." : AppState.ping-proxy-mode == 1 ? "Double: два запроса в одной сессии xray без повторного использования соединения. Берётся лучший результат." : "KeepAlive: два запроса через один транспорт. Второй идёт по уже установленному соединению; берётся лучший результат.";
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        Stepper {
                            title: "Потоков на Wi-Fi";
                            value: AppState.ping-threads;
                            minus => {
                                Actions.set-ping-threads(AppState.ping-threads - 1);
                            }
                            plus => {
                                Actions.set-ping-threads(AppState.ping-threads + 1);
                            }
                        }
                        Stepper {
                            title: "Потоков в мобильной сети";
                            value: AppState.mobile-ping-threads;
                            minus => {
                                Actions.set-mobile-ping-threads(AppState.mobile-ping-threads - 1);
                            }
                            plus => {
                                Actions.set-mobile-ping-threads(AppState.mobile-ping-threads + 1);
                            }
                        }
                        Text {
                            text: "Операторы режут много новых соединений сразу: в мобильной сети серверы проверяются по одному.";
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        Stepper {
                            title: "Таймаут";
                            value: (AppState.ping-timeout / 1000) + " с";
                            minus => {
                                Actions.set-ping-timeout(AppState.ping-timeout - 1000);
                            }
                            plus => {
                                Actions.set-ping-timeout(AppState.ping-timeout + 1000);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ПОДКЛЮЧЕНИЕ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Работа в фоне";
                                font-size: Theme.fs-body;
                                font-weight: 600;
                            }
                            Text {
                                text: AppState.battery-unrestricted ? "Разрешено: Android не остановит VPN ради экономии батареи." : "Android может остановить VPN в фоне, чтобы сберечь батарею. Разрешите DUORAY работать без ограничений.";
                                font-size: Theme.fs-caption;
                                color: AppState.battery-unrestricted ? Theme.muted : Theme.warn;
                                wrap: word-wrap;
                            }
                            if !AppState.battery-unrestricted: HorizontalLayout {
                                Button {
                                    text: "Разрешить";
                                    primary: true;
                                    clicked => {
                                        Actions.request-background();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        ToggleRow {
                            title: "Kill switch";
                            hint: "Если подключение оборвалось, интернет пропадает, а не идёт мимо VPN. Вернуть его: «Подключить» или «Отключить». Если Android выгрузит само приложение, защитит только системное «Блокировать соединения без VPN» в настройках постоянного VPN ниже.";
                            checked: AppState.kill-switch;
                            toggled(on) => {
                                Actions.set-kill-switch(on);
                            }
                        }
                        VerticalLayout {
                            spacing: 8px;
                            Text {
                                text: "Постоянный VPN";
                                font-size: Theme.fs-body;
                                font-weight: 600;
                            }
                            Text {
                                text: "Android сам запускает DUORAY после включения телефона и подключает к последнему серверу. Включается в настройках Android: DUORAY → «Постоянная VPN». Там же можно блокировать интернет без VPN; приложения, пущенные в обход, тогда останутся без сети.";
                                font-size: Theme.fs-caption;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                            HorizontalLayout {
                                Button {
                                    text: "Настройки VPN";
                                    clicked => {
                                        Actions.open-settings("vpn");
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                        ToggleRow {
                            title: "Подключаться при запуске";
                            hint: "Сразу после запуска DUORAY подключается к последнему выбранному серверу.";
                            checked: AppState.autoconnect;
                            toggled(on) => {
                                Actions.set-autoconnect(on);
                            }
                        }
                        ToggleRow {
                            title: "Держать подключение";
                            hint: "Если сервер перестал отвечать, а интернет есть, DUORAY перейдёт на другой сервер той же подписки, самый быстрый по последнему пингу.";
                            checked: AppState.keep-connected;
                            toggled(on) => {
                                Actions.set-keep-connected(on);
                            }
                        }
                        if AppState.keep-connected: Stepper {
                            title: "Переключать через";
                            value: AppState.failover-secs + " с";
                            minus => {
                                Actions.set-failover-secs(AppState.failover-secs - 5);
                            }
                            plus => {
                                Actions.set-failover-secs(AppState.failover-secs + 5);
                            }
                        }
                        ToggleRow {
                            title: "Переключаться при выборе сервера";
                            hint: "Если VPN подключён, выбор другого сервера в списке сразу переключает подключение на него.";
                            checked: AppState.switch-on-select;
                            toggled(on) => {
                                Actions.set-switch-on-select(on);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "УВЕДОМЛЕНИЕ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        ToggleRow {
                            title: "Свернуть уведомление";
                            hint: "Пока VPN работает, Android требует уведомление, убрать его совсем нельзя. Свёрнутое лежит внизу шторки одной строкой, без значка в строке состояния.";
                            checked: AppState.quiet-notification;
                            toggled(on) => {
                                Actions.set-quiet-notification(on);
                            }
                        }
                        if !AppState.quiet-notification: ToggleRow {
                            title: "Закреплять в шторке";
                            hint: "Android 16 и новее: подключение висит наверху шторки и значком в строке состояния (Live Update).";
                            checked: AppState.live-update;
                            toggled(on) => {
                                Actions.set-live-update(on);
                            }
                        }
                        ToggleRow {
                            title: "Скорость в шторке в фоне";
                            hint: "Пока приложение закрыто, уведомление показывает скорость и страну выхода: DUORAY раз в 3 секунды спрашивает счётчики у xray. Выключите, чтобы беречь батарею.";
                            checked: AppState.background-stats;
                            toggled(on) => {
                                Actions.set-background-stats(on);
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ДРУГИЕ УСТРОЙСТВА";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        ToggleRow {
                            title: "Доступ через хотспот";
                            hint: "Телефон становится SOCKS5 и HTTP-прокси для устройств в той же Wi-Fi сети или на его точке доступа: укажите прокси в их настройках сети. Работает, пока VPN подключён.";
                            checked: AppState.share-enabled;
                            toggled(on) => {
                                Actions.set-share(on);
                            }
                        }
                        if AppState.share-enabled: Text {
                            text: AppState.share-addresses;
                            font-family: "monospace";
                            font-size: Theme.fs-small;
                            color: Theme.fg;
                            wrap: word-wrap;
                        }
                        if AppState.share-enabled && !AppState.local-network: Text {
                            text: "Android не пускает к телефону устройства из сети: разрешите DUORAY доступ к локальной сети.";
                            font-size: Theme.fs-caption;
                            color: Theme.warn;
                            wrap: word-wrap;
                        }
                        if AppState.share-enabled && !AppState.local-network: HorizontalLayout {
                            Button {
                                text: "Разрешить";
                                primary: true;
                                clicked => {
                                    Actions.request-local-network();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        if AppState.share-enabled: ToggleRow {
                            title: "Логин и пароль";
                            hint: "Без них прокси может использовать любое устройство в сети и любое приложение на телефоне, в том числе для проверки, включён ли VPN.";
                            checked: AppState.share-auth;
                            toggled(on) => {
                                Actions.set-share-auth(on);
                            }
                        }
                        if AppState.share-enabled && AppState.share-auth: Text {
                            text: AppState.share-user + " / " + AppState.share-pass;
                            font-family: "monospace";
                            font-size: Theme.fs-small;
                            color: Theme.fg;
                        }
                        if AppState.share-enabled && AppState.share-auth: HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Скопировать";
                                clicked => {
                                    Actions.copy-text(AppState.share-user + ":" + AppState.share-pass);
                                }
                            }
                            Button {
                                text: "Новый пароль";
                                clicked => {
                                    Actions.new-share-password();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ОТЧЁТЫ И ОБНОВЛЕНИЯ";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 14px;
                        ToggleRow {
                            title: "Отправлять отчёты об ошибках";
                            hint: "Версия, система, текст ошибки и журнал последних действий, чтобы мы нашли и исправили проблему. Ссылки подписок, адреса и названия серверов, ключи и UUID вырезаются.";
                            checked: AppState.telemetry;
                            toggled(on) => {
                                Actions.set-telemetry(on);
                            }
                        }
                        ToggleRow {
                            title: "Проверять обновления";
                            hint: "Новая версия скачивается по Wi-Fi и проверяется по цифровой подписи. Устанавливается только по вашему нажатию.";
                            checked: AppState.auto-update;
                            toggled(on) => {
                                Actions.set-auto-update(on);
                            }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Проверить обновления";
                                clicked => {
                                    Actions.check-update();
                                }
                            }
                            Rectangle {
                                horizontal-stretch: 1;
                            }
                        }
                        if AppState.update-info != "": Text {
                            text: AppState.update-info;
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        Divider { }
                        VerticalLayout {
                            spacing: 8px;
                            HorizontalLayout {
                                Button {
                                    text: "Сообщить о проблеме";
                                    clicked => {
                                        Actions.report-problem();
                                    }
                                }
                                Rectangle {
                                    horizontal-stretch: 1;
                                }
                            }
                            Text {
                                text: "Опишите, что случилось, и вы получите код отчёта. Передайте его в поддержку.";
                                font-size: Theme.fs-caption;
                                color: Theme.muted;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ЯДРО XRAY";
                    }
                }
                Card {
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 10px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text {
                                text: AppState.core-label;
                                font-size: Theme.fs-body;
                                font-weight: 600;
                                overflow: elide;
                            }
                        }
                        Button {
                            text: "Выбрать";
                            clicked => {
                                root.cores();
                            }
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 6px;
                    padding-top: 6px;
                    SectionLabel {
                        text: "ЖУРНАЛ XRAY";
                    }
                }
                Card {
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Button {
                            text: AppState.xray-log == "" ? "Показать" : "Обновить";
                            clicked => {
                                Actions.load-log();
                            }
                        }
                        if AppState.xray-log != "": Text {
                            text: AppState.xray-log;
                            font-family: "monospace";
                            font-size: 10px;
                            color: Theme.muted;
                            wrap: char-wrap;
                        }
                    }
                }
                // About DUORAY (GPL "Appropriate Legal Notices"), as on the desktop.
                Card {
                    VerticalLayout {
                        padding: 14px;
                        spacing: 10px;
                        Text {
                            text: "DUORAY " + AppState.version;
                            font-size: Theme.fs-title;
                            font-weight: 700;
                        }
                        Text {
                            text: "Клиент DUALIZM VPN на xray-core. Разработчик — DUALIZM. Новости и поддержка — в Telegram-канале @dualizm_vpn.";
                            font-size: Theme.fs-small;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Сайт";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.open-url("https://duoray.pro");
                                }
                            }
                            Button {
                                text: "@dualizm_vpn";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.open-url("https://t.me/dualizm_vpn");
                                }
                            }
                        }
                        Divider { }
                        Text {
                            text: "© 2026 DUALIZM. Свободная программа: распространяется по лицензии GNU GPL v3, её можно изучать, менять и распространять. Поставляется без каких-либо гарантий. Учебный эксперимент, код написан с помощью ИИ-ассистента.";
                            font-size: Theme.fs-caption;
                            color: Theme.muted;
                            wrap: word-wrap;
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            Button {
                                text: "Исходный код";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.open-url("https://github.com/m-a-prod/DUORAY-Mobile");
                                }
                            }
                            Button {
                                text: "Лицензия";
                                horizontal-stretch: 1;
                                clicked => {
                                    Actions.open-url("https://github.com/m-a-prod/DUORAY-Mobile/blob/main/LICENSE");
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// «Ядро Xray»: the bundled core, installed releases and the ones on GitHub,
// as MaterialXray picks its core.
component CoreItem inherits Rectangle {
    in property <CoreRow> core;
    height: 62px * Theme.text-scale;
    background: touch.pressed && root.core.installed ? Theme.fg.with-alpha(0.06) : transparent;
    touch := TouchArea {
        enabled: root.core.installed && !root.core.selected;
        clicked => {
            Actions.select-core(root.core.tag);
        }
    }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 8px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            width: 20px;
            Rectangle {
                width: 20px;
                height: 20px;
                border-radius: 10px;
                border-width: 2px;
                border-color: root.core.selected ? Theme.accent : Theme.line;
                opacity: root.core.installed ? 1 : 0.3;
                Rectangle {
                    width: 10px;
                    height: 10px;
                    border-radius: 5px;
                    background: Theme.accent;
                    opacity: root.core.selected ? 1 : 0;
                }
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: root.core.tag == "" ? "Встроенное" : root.core.tag;
                    font-size: Theme.fs-body;
                    font-weight: 600;
                    overflow: elide;
                    horizontal-stretch: 0;
                }
                if root.core.pre: Chip {
                    text: "пре-релиз";
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
            }
            Text {
                text: root.core.detail;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if root.core.progress != "": VerticalLayout {
            alignment: center;
            Text {
                text: root.core.progress;
                font-size: Theme.fs-small;
                color: Theme.muted;
            }
        }
        if !root.core.installed && root.core.progress == "": VerticalLayout {
            alignment: center;
            Button {
                text: "Скачать";
                height: 36px;
                clicked => {
                    Actions.install-core(root.core.tag);
                }
            }
        }
        if root.core.installed && !root.core.selected && root.core.tag != "": VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.delete;
                label: "Удалить " + root.core.tag;
                clicked => {
                    Actions.remove-core(root.core.tag);
                }
            }
        }
    }
}

component CoresPage inherits Rectangle {
    in property <length> bottom-inset;
    callback back();
    background: Theme.bg;
    TouchArea { }
    VerticalLayout {
        PageHeader {
            text: "Ядро Xray";
            back => {
                root.back();
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: list.preferred-height;
            list := VerticalLayout {
                alignment: start;
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: root.bottom-inset + 16px;
                spacing: 10px;
                Text {
                    text: "Встроенное ядро обновляется вместе с DUORAY. Другую версию можно скачать из релизов XTLS/Xray-core на GitHub: перед установкой она сверяется с контрольной суммой релиза. Смена ядра переподключает VPN.";
                    font-size: Theme.fs-caption;
                    color: Theme.muted;
                    wrap: word-wrap;
                }
                if AppState.cores-error != "": Text {
                    text: AppState.cores-error;
                    font-size: Theme.fs-caption;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                Card {
                    VerticalLayout {
                        for core[i] in AppState.cores: VerticalLayout {
                            if i > 0: Divider { }
                            CoreItem {
                                core: core;
                            }
                        }
                    }
                }
                if AppState.cores-loading: HorizontalLayout {
                    alignment: center;
                    Spinner {
                        width: 28px;
                        height: 28px;
                        indeterminate: true;
                    }
                }
            }
        }
    }
}

// ── Sheets ─────────────────────────────────────────────────────

component InputSheet inherits Rectangle {
    in property <length> top-inset;
    in property <string> title;
    in property <string> hint;
    in property <string> placeholder;
    // A link that opened the app (duoray://add/...), already filled in.
    in property <string> initial;
    callback close();
    callback submit(string);
    background: Theme.shadow;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    Rectangle {
        x: 12px;
        y: root.top-inset + 12px;
        width: parent.width - 24px;
        height: panel.preferred-height;
        background: Theme.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.outline;
        TouchArea { }
        panel := VerticalLayout {
            padding: 16px;
            spacing: 10px;
            Text {
                text: root.title;
                font-size: Theme.fs-heading;
                font-weight: 800;
            }
            Text {
                text: root.hint;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Rectangle {
                height: 110px;
                border-radius: 12px;
                background: Theme.bg;
                border-width: input.has-focus ? 2px : 1px;
                border-color: input.has-focus ? Theme.accent : Theme.line;
                input := TextInput {
                    x: 12px;
                    y: 10px;
                    width: parent.width - 24px;
                    height: parent.height - 20px;
                    text: root.initial;
                    single-line: false;
                    wrap: char-wrap;
                    font-size: Theme.fs-small;
                    color: Theme.fg;
                    selection-background-color: Theme.accent.with-alpha(0.3);
                }
                if input.text == "": Text {
                    x: 12px;
                    y: 10px;
                    text: root.placeholder;
                    font-size: Theme.fs-small;
                    color: Theme.muted;
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Вставить";
                    clicked => {
                        input.focus();
                        input.paste();
                    }
                }
                Button {
                    text: "QR-код";
                    clicked => {
                        root.close();
                        Actions.scan-qr();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Добавить";
                    primary: true;
                    enabled: input.text != "";
                    clicked => {
                        root.submit(input.text);
                        root.close();
                    }
                }
            }
        }
    }
}

component PickerSheet inherits Rectangle {
    in property <int> target;
    in property <length> top-inset;
    in property <length> bottom-inset;
    callback close();
    background: Theme.bg;
    init => {
        Actions.filter-picker("");
    }
    TouchArea { }
    VerticalLayout {
        padding-top: root.top-inset;
        padding-bottom: root.bottom-inset;
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 4px;
            padding-top: 4px;
            spacing: 8px;
            Text {
                text: root.target == 0 ? "Сервер для Wi-Fi" : root.target == 1 ? "Сервер для мобильной сети" : "Сервер для «" + AppState.current-ssid + "»";
                font-size: Theme.fs-heading;
                font-weight: 800;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            IconButton {
                icon: Icons.close;
                        label: "Закрыть";
                clicked => {
                    root.close();
                }
            }
        }
        HorizontalLayout {
            padding-left: 16px;
            padding-bottom: 6px;
            Text {
                text: "Серверы подписки " + AppState.header-title + "; другую можно выбрать на вкладке «Серверы»";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
            }
        }
        if root.target != 2: Rectangle {
            height: 50px;
            background: clear-touch.pressed ? Theme.fg.with-alpha(0.06) : transparent;
            clear-touch := TouchArea {
                clicked => {
                    Actions.pick-for(root.target, -1);
                    root.close();
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                Text {
                    text: "Не выбирать: сервер, выбранный вручную";
                    font-size: Theme.fs-body;
                    color: Theme.accent;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: 6px;
            Rectangle {
                height: 42px;
                border-radius: 21px;
                background: Theme.card;
                border-width: 1px;
                border-color: picker-search.has-focus ? Theme.accent : Theme.outline;
                picker-search := TextInput {
                    x: 16px;
                    width: parent.width - 32px;
                    height: parent.height;
                    vertical-alignment: center;
                    font-size: Theme.fs-body;
                    color: Theme.fg;
                    single-line: true;
                    edited => {
                        Actions.filter-picker(self.text);
                    }
                }
                if picker-search.text == "": Text {
                    x: 16px;
                    text: "Поиск сервера";
                    font-size: Theme.fs-body;
                    color: Theme.muted;
                    vertical-alignment: center;
                }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: pick-list.preferred-height;
            pick-list := VerticalLayout {
                alignment: start;
                for row[i] in AppState.servers: HorizontalLayout {
                    visible: !AppState.picker-hidden[i];
                    height: AppState.picker-hidden[i] ? 0px : self.preferred-height;
                    padding-left: 6px;
                    padding-right: 6px;
                    ServerItem {
                        server: row;
                        show-selection: false;
                        clicked => {
                            Actions.pick-for(root.target, i);
                            root.close();
                        }
                    }
                }
        
            }
        }
    }
}

component ConfirmSheet inherits Rectangle {
    in property <string> title;
    in property <string> action;
    callback confirmed();
    callback close();
    background: Theme.shadow;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    Rectangle {
        x: 24px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 48px;
        height: box.preferred-height;
        background: Theme.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.outline;
        TouchArea { }
        box := VerticalLayout {
            padding: 18px;
            spacing: 16px;
            Text {
                text: root.title;
                font-size: Theme.fs-title;
                font-weight: 700;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Button {
                    text: "Отмена";
                    clicked => {
                        root.close();
                    }
                }
                Button {
                    text: root.action;
                    danger: true;
                    clicked => {
                        root.confirmed();
                        root.close();
                    }
                }
            }
        }
    }
}

// A bottom sheet of actions for the shown subscription (the desktop's ⋯ menu).
component SubMenuSheet inherits Rectangle {
    in property <length> bottom-inset;
    callback close();
    callback remove();
    callback identity();
    background: Theme.shadow;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: menu.preferred-height;
        background: Theme.card;
        border-radius: 22px;
        border-width: 1px;
        border-color: Theme.outline;
        TouchArea { }
        menu := VerticalLayout {
            padding: 8px;
            padding-bottom: max(root.bottom-inset, 12px) + 8px;
            // Grab handle.
            HorizontalLayout {
                alignment: center;
                padding-bottom: 6px;
                Rectangle {
                    width: 36px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.line;
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-bottom: 6px;
                Text {
                    text: AppState.header-title;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    overflow: elide;
                }
            }
            for item[i] in [
                { text: "Подключиться к самому быстрому", danger: false },
                { text: "Скопировать ссылку", danger: false },
                { text: "QR-код", danger: false },
                { text: "Подмена HWID", danger: false },
                { text: "Удалить подписку", danger: true },
            ]: Rectangle {
                height: 52px;
                border-radius: 12px;
                background: item-touch.pressed ? Theme.fg.with-alpha(0.08) : transparent;
                item-touch := TouchArea {
                    clicked => {
                        root.close();
                        if (i == 0) {
                            Actions.connect-fastest();
                        } else if (i == 1) {
                            Actions.copy-link();
                        } else if (i == 2) {
                            Actions.show-qr();
                        } else if (i == 3) {
                            root.identity();
                        } else {
                            root.remove();
                        }
                    }
                }
                HorizontalLayout {
                    padding-left: 16px;
                    Text {
                        text: item.text;
                        font-size: Theme.fs-body;
                        color: item.danger ? Theme.danger : Theme.fg;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// A server's own page: its xray config as JSON, editable (the desktop's
// server editor in JSON mode). An edit sticks across subscription updates.
component ServerPage inherits Rectangle {
    in property <length> bottom-inset;
    callback back();
    background: Theme.bg;
    TouchArea { }
    VerticalLayout {
        PageHeader {
            text: AppState.edit-name;
            back => {
                root.back();
            }
        }
        VerticalLayout {
            padding-left: 12px;
            padding-right: 12px;
            padding-bottom: root.bottom-inset + 10px;
            spacing: 8px;
            Text {
                text: AppState.edit-meta;
                font-size: Theme.fs-caption;
                color: Theme.muted;
                overflow: elide;
            }
            json := TextEdit {
                vertical-stretch: 1;
                text: AppState.edit-json;
                wrap: char-wrap;
                font-size: 12px;
                edited => {
                    AppState.edit-error = "";
                }
            }
            if AppState.edit-error != "": Text {
                text: AppState.edit-error;
                font-size: Theme.fs-caption;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "Скопировать";
                    clicked => {
                        Actions.copy-text(json.text);
                    }
                }
                if AppState.edit-edited: Button {
                    text: "Вернуть";
                    danger: true;
                    clicked => {
                        Actions.reset-server();
                    }
                }
                Rectangle {
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Сохранить";
                    primary: true;
                    clicked => {
                        Actions.save-server(json.text);
                    }
                }
            }
        }
    }
}

// "Подмена HWID": how the shown subscription identifies itself to its panel.
component IdentitySheet inherits Rectangle {
    in property <length> bottom-inset;
    callback close();
    background: Theme.shadow;
    TouchArea {
        clicked => {
            root.close();
        }
    }
    Rectangle {
        y: parent.height - self.height;
        height: box.preferred-height;
        background: Theme.card;
        border-radius: 22px;
        border-width: 1px;
        border-color: Theme.outline;
        TouchArea { }
        box := VerticalLayout {
            padding: 16px;
            padding-bottom: max(root.bottom-inset, 12px) + 12px;
            spacing: 10px;
            Text {
                text: "Подмена HWID · " + AppState.header-title;
                font-size: Theme.fs-title;
                font-weight: 700;
                overflow: elide;
            }
            HorizontalLayout {
                spacing: 4px;
                for mode[i] in ["Как в настройках", "DUORAY", "Happ"]: Segment {
                    text: mode;
                    active: AppState.sub-id-mode == i;
                    clicked => {
                        Actions.set-sub-id-mode(i);
                    }
                }
            }
            Text {
                text: AppState.sub-id-mode == 0 ? "Подписка представляется так же, как в настройках." : AppState.sub-id-mode == 1 ? "DUORAY со своим HWID для этой панели: новое устройство в лимите, когда старое заблокировано." : "Свой отпечаток Happ для этой панели:";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            if AppState.sub-id-mode == 1: HorizontalLayout {
                spacing: 8px;
                Rectangle {
                    horizontal-stretch: 1;
                    height: 42px;
                    border-radius: 10px;
                    background: Theme.bg;
                    border-width: hwid-input.has-focus ? 2px : 1px;
                    border-color: hwid-input.has-focus ? Theme.accent : Theme.line;
                    hwid-input := TextInput {
                        x: 12px;
                        width: parent.width - 24px;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        text: AppState.sub-hwid;
                        font-family: "monospace";
                        font-size: Theme.fs-caption;
                        color: Theme.fg;
                        edited => {
                            Actions.set-sub-hwid(self.text);
                        }
                    }
                    if hwid-input.text == "": Text {
                        x: 12px;
                        text: "HWID устройства";
                        font-size: Theme.fs-caption;
                        color: Theme.muted;
                        vertical-alignment: center;
                    }
                }
                Button {
                    text: "Случайный";
                    clicked => {
                        Actions.sub-random-hwid();
                    }
                }
            }
            if AppState.sub-id-mode == 2: Text {
                text: AppState.sub-happ-ua;
                font-family: "monospace";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: char-wrap;
            }
            if AppState.sub-id-mode == 2: Button {
                text: "Новое устройство";
                clicked => {
                    Actions.sub-new-happ();
                }
            }
        }
    }
}

// Asked once, on the first start: may DUORAY send error reports?
component ConsentSheet inherits Rectangle {
    background: Theme.shadow;
    // An answer is needed: a tap outside does not close it.
    TouchArea { }
    Rectangle {
        x: 20px;
        y: (parent.height - self.height) / 2;
        width: parent.width - 40px;
        height: consent-box.preferred-height;
        background: Theme.card;
        border-radius: 22px;
        border-width: 1px;
        border-color: Theme.outline;
        consent-box := VerticalLayout {
            padding: 20px;
            spacing: 12px;
            Text {
                text: "Отчёты об ошибках";
                font-size: Theme.fs-title;
                font-weight: 700;
            }
            Text {
                text: "Если что-то сломается, DUORAY может отправить нам отчёт, чтобы мы быстрее нашли и исправили ошибку. Отправлять или нет, решаете вы.";
                font-size: Theme.fs-small;
                wrap: word-wrap;
            }
            Text {
                text: "В отчёте: версия DUORAY и Android, модель телефона, текст ошибки, журнал последних действий, тип протокола и ваши настройки маршрутизации.";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Text {
                text: "Никогда не отправляются: ссылки подписок, адреса и названия серверов, ключи и UUID. Ваш IP-адрес с отчётом не сохраняется. Отчёты хранятся 90 дней.";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            Text {
                text: "Передумать можно в любой момент: Настройки → Отчёты и обновления.";
                font-size: Theme.fs-caption;
                color: Theme.muted;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: 8px;
                padding-top: 4px;
                alignment: end;
                Button {
                    text: "Не отправлять";
                    clicked => {
                        Actions.consent(false);
                    }
                }
                Button {
                    text: "Разрешить";
                    primary: true;
                    clicked => {
                        Actions.consent(true);
                    }
                }
            }
        }
    }
}

// "Сообщить о проблеме": a note, a look at what goes out, then the code.
// No conditional sub-layouts here: Slint under-measures wrapped text in
// them, which cut the buttons off.
component ReportSheet inherits Rectangle {
    in property <length> top-inset;
    callback close();
    property <string> note;
    property <bool> sent: AppState.report-code != "";
    background: Theme.shadow;
    TouchArea {
        clicked => {
            if !AppState.report-busy {
                root.close();
            }
        }
    }
    Rectangle {
        x: 12px;
        y: root.top-inset + 12px;
        width: parent.width - 24px;
        height: min(panel.preferred-height, root.height - root.top-inset - 24px);
        background: Theme.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: Theme.outline;
        clip: true;
        TouchArea { }
        // Scrolls when it does not fit (landscape).
        Flickable {
            content-width: self.width;
            content-height: panel.preferred-height;
            panel := VerticalLayout {
                width: parent.width;
                padding: 16px;
                spacing: 10px;
                Text {
                    text: "Сообщить о проблеме";
                    font-size: Theme.fs-heading;
                    font-weight: 800;
                }
                Text {
                    text: root.sent ? "Отчёт отправлен. Код отчёта, передайте его в поддержку:" : "Что случилось и что вы делали перед этим? Вместе с описанием уйдёт журнал последних действий, без ссылок, адресов серверов и ключей.";
                    font-size: root.sent ? Theme.fs-small : Theme.fs-caption;
                    color: root.sent ? Theme.fg : Theme.muted;
                    wrap: word-wrap;
                }
                if root.sent: Text {
                    text: AppState.report-code;
                    font-size: 28px;
                    font-weight: 800;
                    color: Theme.accent;
                    horizontal-alignment: center;
                }
                if !root.sent: Rectangle {
                    height: 110px;
                    border-radius: 12px;
                    background: Theme.bg;
                    border-width: note.has-focus ? 2px : 1px;
                    border-color: note.has-focus ? Theme.accent : Theme.line;
                    note := TextInput {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        height: parent.height - 20px;
                        text <=> root.note;
                        single-line: false;
                        wrap: word-wrap;
                        font-size: Theme.fs-small;
                        color: Theme.fg;
                        selection-background-color: Theme.accent.with-alpha(0.3);
                    }
                    if root.note == "": Text {
                        x: 12px;
                        y: 10px;
                        width: parent.width - 24px;
                        text: "Например: не подключается к Нидерландам после обновления";
                        font-size: Theme.fs-small;
                        color: Theme.muted;
                        wrap: word-wrap;
                    }
                }
                if !root.sent && AppState.report-preview != "": Rectangle {
                    height: 200px;
                    border-radius: 12px;
                    background: Theme.bg;
                    clip: true;
                    Flickable {
                        content-width: self.width;
                        content-height: preview.preferred-height + 20px;
                        preview := Text {
                            x: 10px;
                            y: 10px;
                            width: parent.width - 20px;
                            text: AppState.report-preview;
                            font-family: "monospace";
                            font-size: 10px;
                            color: Theme.muted;
                            wrap: char-wrap;
                        }
                    }
                }
                if AppState.report-error != "": Text {
                    text: AppState.report-error;
                    font-size: Theme.fs-caption;
                    color: Theme.danger;
                    wrap: word-wrap;
                }
                HorizontalLayout {
                    spacing: 8px;
                    Button {
                        text: root.sent ? "Скопировать код" : AppState.report-preview == "" ? "Что отправится?" : "Обновить";
                        clicked => {
                            if root.sent {
                                Actions.copy-text(AppState.report-code);
                            } else {
                                Actions.report-preview(root.note);
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                    }
                    Button {
                        text: root.sent ? "Готово" : AppState.report-busy ? "Отправка…" : "Отправить";
                        primary: true;
                        enabled: !AppState.report-busy;
                        clicked => {
                            if root.sent {
                                root.close();
                            } else {
                                Actions.report-send(root.note);
                            }
                        }
                    }
                }
            }
        }
    }
}

// A newer DUORAY, as MaterialXray shows it: the whole card is the button
// (download, then the system installer), a bar while it downloads. Shown
// like ExpiryBanner.
component UpdateBanner inherits Rectangle {
    in property <bool> show;
    visible: root.show;
    height: root.show ? self.preferred-height : 0px;
    background: touch.pressed ? Theme.tonal.darker(0.1) : Theme.tonal;
    border-radius: Theme.radius;
    touch := TouchArea {
        enabled: AppState.update-progress < 0;
        clicked => {
            Actions.update-clicked();
        }
    }
    HorizontalLayout {
        padding: 16px;
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("icons/system-update.svg");
                width: 24px;
                height: 24px;
                colorize: Theme.on-tonal;
            }
        }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text {
                text: AppState.update-banner;
                font-size: Theme.fs-body;
                font-weight: 700;
                color: Theme.on-tonal;
            }
            Text {
                text: AppState.update-detail;
                font-size: Theme.fs-small;
                color: Theme.on-tonal;
                wrap: word-wrap;
            }
            Rectangle {
                height: AppState.update-progress >= 0 ? 10px : 0px;
                visible: AppState.update-progress >= 0;
                Rectangle {
                    y: 6px;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.on-tonal.with-alpha(0.2);
                    Rectangle {
                        x: 0;
                        width: parent.width * max(0, AppState.update-progress);
                        border-radius: 2px;
                        background: Theme.accent;
                        animate width { duration: 200ms; }
                    }
                }
            }
        }
    }
}

// The end-of-subscription reminder, above the list. Always in the layout,
// zero high when hidden: Slint mis-measures wrapped text in `if` elements.
component ExpiryBanner inherits Rectangle {
    in property <bool> show;
    visible: root.show;
    height: root.show ? self.preferred-height : 0px;
    background: Theme.warn.with-alpha(0.14);
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: Theme.warn.with-alpha(0.4);
    HorizontalLayout {
        padding: 6px;
        padding-left: 14px;
        spacing: 6px;
        Text {
            text: AppState.expiry-text;
            font-size: Theme.fs-small;
            font-weight: 600;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if AppState.expiry-can-renew: VerticalLayout {
            alignment: center;
            Button {
                text: "Продлить";
                primary: true;
                height: 36px;
                clicked => {
                    Actions.renew();
                }
            }
        }
        VerticalLayout {
            alignment: center;
            IconButton {
                icon: Icons.close;
                label: "Скрыть напоминание";
                clicked => {
                    Actions.dismiss-expiry();
                }
            }
        }
    }
}

// ── Window ─────────────────────────────────────────────────────

export component AppWindow inherits Window {
    title: "DUORAY";
    background: Theme.bg;
    preferred-width: 412px;
    preferred-height: 892px;
    default-font-size: Theme.fs-body;
    default-font-family: "Noto Sans";
    // 0 servers, 1 routing, 2 settings; the apps list opens over routing.
    in-out property <int> page;
    in-out property <bool> apps-open;
    in-out property <bool> cores-open;
    in-out property <bool> adding;
    // Rust opens the add sheet for a duoray:// link.
    callback open-add();
    open-add => {
        root.page = 0;
        root.adding = true;
    }
    // -1 hidden, else the pick-for target.
    in-out property <int> picking: -1;
    in-out property <bool> confirm-remove;
    in-out property <bool> sub-menu;
    in-out property <bool> identity-open;
    in-out property <bool> qr-open;
    in-out property <bool> server-open;
    // Something Back closes (mirrors the key handler below); at the top level
    // Back belongs to the system, which then plays its predictive animation.
    out property <bool> can-go-back: AppState.consent-open || AppState.report-open || root.qr-open || root.identity-open
        || root.sub-menu || root.adding || root.picking >= 0 || root.confirm-remove || root.server-open || root.apps-open
        || root.cores-open
        || root.page != 0;
    changed can-go-back => {
        Actions.back-state(self.can-go-back);
    }
    out property <bool> light-theme: Theme.light;
    changed light-theme => {
        Actions.light-bars(self.light-theme);
    }
    callback open-server-page();
    open-server-page => {
        root.server-open = true;
    }
    callback close-server-page();
    close-server-page => {
        root.server-open = false;
    }
    callback open-qr();
    open-qr => {
        root.qr-open = true;
    }
    property <length> top: root.safe-area-insets.top;
    property <length> bottom: root.safe-area-insets.bottom;
    // Std-widget defaults (text without its own color, spinners) follow the
    // chosen theme, not the phone's scheme: 0 system, 1 dark, 2 light.
    property <int> scheme: Theme.follow-system ? 0 : Theme.c-light ? 2 : 1;
    changed scheme => {
        Palette.color-scheme = root.scheme == 0 ? ColorScheme.unknown : root.scheme == 2 ? ColorScheme.light : ColorScheme.dark;
    }
    init => {
        Palette.color-scheme = root.scheme == 0 ? ColorScheme.unknown : root.scheme == 2 ? ColorScheme.light : ColorScheme.dark;
    }
    // Back closes what is open before leaving the app. Called from Rust for
    // Android's back gesture (whatever has the focus) and from the key below.
    public function go-back() -> bool {
        if (AppState.consent-open) {
            // An answer is needed.
        } else if (AppState.report-open) {
            if (!AppState.report-busy) {
                AppState.report-open = false;
            }
        } else if (root.qr-open) {
            root.qr-open = false;
        } else if (root.identity-open) {
            root.identity-open = false;
        } else if (root.sub-menu) {
            root.sub-menu = false;
        } else if (root.adding) {
            root.adding = false;
        } else if (root.picking >= 0) {
            root.picking = -1;
        } else if (root.confirm-remove) {
            root.confirm-remove = false;
        } else if (root.server-open) {
            root.server-open = false;
        } else if (root.cores-open) {
            root.cores-open = false;
        } else if (root.apps-open) {
            root.apps-open = false;
        } else if (root.page != 0) {
            root.page = 0;
        } else {
            return false;
        }
        true
    }
    forward-focus: back-keys;
    back-keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(event) => {
            if (event.text != Key.Back && event.text != Key.Escape) {
                return reject;
            }
            if (root.go-back()) {
                return accept;
            }
            reject
        }
    }

    VerticalLayout {
        padding-top: root.top;
        padding-left: root.safe-area-insets.left;
        padding-right: root.safe-area-insets.right;
        if root.page == 0: VerticalLayout {
            vertical-stretch: 1;
            HorizontalLayout {
                height: 52px;
                padding-left: 20px;
                padding-right: 10px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: AppState.conn-state == "connected" ? (Theme.light ? Icons.logo-on-light : Icons.logo-on) : Icons.logo-off;
                        width: 22px;
                        height: 18px;
                    }
                }
                Text {
                    text: "DUORAY";
                    font-size: 18px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    IconButton {
                        icon: Icons.add;
                        label: "Добавить подписку или ключи";
                        clicked => {
                            root.adding = true;
                        }
                    }
                }
            }
            if !AppState.has-sub: EmptyServers {
                vertical-stretch: 1;
                add-clicked => {
                    root.adding = true;
                }
            }
            // One scroll, as in Material Xray: connection, then the
            // subscription with its servers.
            if AppState.has-sub: Flickable {
                vertical-stretch: 1;
                content-width: self.width;
                content-height: home.preferred-height;
                home := VerticalLayout {
                    alignment: start;
                    spacing: 8px;
                    padding-top: 4px;
                    padding-bottom: 96px;
                    if AppState.subs.length + (AppState.has-manual ? 1 : 0) > 1: Chips { }
                    VerticalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        UpdateBanner {
                            show: AppState.update-banner != "";
                        }
                        Rectangle {
                            height: AppState.update-banner != "" ? 8px : 0px;
                        }
                        ExpiryBanner {
                            show: AppState.expiry-text != "";
                        }
                        Rectangle {
                            height: AppState.expiry-text != "" ? 8px : 0px;
                        }
                        Card {
                            VerticalLayout {
                                HeaderCard {
                                    border-width: 0px;
                                    background: transparent;
                                    more-clicked => {
                                        root.sub-menu = true;
                                    }
                                }
                                for row[i] in AppState.servers: VerticalLayout {
                                    Divider { }
                                    ServerItem {
                                        server: row;
                                        radio: true;
                                        border-radius: 0px;
                                        manual: AppState.manual-selected;
                                        clicked => {
                                            Actions.select-server(i);
                                        }
                                        long-pressed => {
                                            Actions.ping-server(i);
                                        }
                                        open => {
                                            Actions.open-server(i);
                                        }
                                        remove => {
                                            Actions.remove-server(i);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
        if root.page == 1: RoutingPage {
            vertical-stretch: 1;
            pick(target) => {
                root.picking = target;
            }
            open-apps => {
                Actions.load-apps();
                root.apps-open = true;
            }
        }
        if root.page == 2: SettingsPage {
            vertical-stretch: 1;
            cores => {
                root.cores-open = true;
                Actions.open-cores();
            }
        }
        // The bottom bar: no outline, its sides would sit on the curved edges
        // of the screen (only the OLED palette has one).
        Rectangle {
            height: 64px + max(root.bottom, 8px);
            background: Theme.card;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                padding-bottom: max(root.bottom, 8px);
                NavItem {
                    icon: @image-url("icons/list.svg");
                    text: "Серверы";
                    active: root.page == 0;
                    clicked => {
                        root.page = 0;
                    }
                }
                NavItem {
                    icon: @image-url("icons/route.svg");
                    text: "Маршрутизация";
                    active: root.page == 1;
                    clicked => {
                        root.page = 1;
                    }
                }
                NavItem {
                    icon: @image-url("icons/settings.svg");
                    text: "Настройки";
                    active: root.page == 2;
                    clicked => {
                        root.page = 2;
                    }
                }
            }
        }
    }

    if root.page == 0 && !root.apps-open && !root.server-open && !root.cores-open: ConnectionCard {
        x: 12px + root.safe-area-insets.left;
        width: parent.width - 24px - root.safe-area-insets.left - root.safe-area-insets.right;
        y: parent.height - (64px + max(root.bottom, 8px)) - self.height - 10px;
    }
    if root.server-open: ServerPage {
        y: root.top;
        height: parent.height - root.top;
        bottom-inset: root.bottom;
        back => {
            root.server-open = false;
        }
    }
    if root.cores-open: CoresPage {
        y: root.top;
        height: parent.height - root.top;
        bottom-inset: root.bottom;
        back => {
            root.cores-open = false;
        }
    }
    if root.apps-open: AppsPage {
        y: root.top;
        height: parent.height - root.top;
        bottom-inset: root.bottom;
        back => {
            root.apps-open = false;
        }
    }
    if AppState.toast != "": Rectangle {
        x: 24px;
        y: parent.height - root.bottom - self.height - 200px;
        width: parent.width - 48px;
        height: toast-text.preferred-height + 22px;
        border-radius: 12px;
        background: Theme.light ? #322f35 : #e6e0e9;
        toast-text := Text {
            x: 14px;
            width: parent.width - 28px;
            text: AppState.toast;
            font-size: Theme.fs-small;
            color: Theme.light ? #f5eff7 : #322f35;
            wrap: word-wrap;
        }
    }
    if root.adding: InputSheet {
        top-inset: root.top;
        initial: AppState.add-prefill;
        title: "Добавить";
        hint: "Ссылка на подписку или ключи vless://, vmess://, trojan://, ss://, hysteria2://";
        placeholder: "https://… или vless://…";
        close => {
            root.adding = false;
        }
        submit(text) => {
            Actions.add-subscription(text);
        }
    }
    if root.picking >= 0: PickerSheet {
        target: root.picking;
        top-inset: root.top;
        bottom-inset: root.bottom;
        close => {
            root.picking = -1;
        }
    }
    if root.sub-menu: SubMenuSheet {
        bottom-inset: root.bottom;
        close => {
            root.sub-menu = false;
        }
        remove => {
            root.confirm-remove = true;
        }
        identity => {
            root.identity-open = true;
        }
    }
    if root.qr-open: Rectangle {
        background: Theme.shadow;
        TouchArea {
            clicked => {
                root.qr-open = false;
            }
        }
        Rectangle {
            x: 24px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 48px;
            height: qr-box.preferred-height;
            background: Theme.card;
            border-radius: 22px;
            border-width: 1px;
            border-color: Theme.outline;
            qr-box := VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: AppState.header-title;
                    font-size: Theme.fs-title;
                    font-weight: 700;
                    horizontal-alignment: center;
                }
                // White around the code whatever the theme: cameras need it.
                Image {
                    source: AppState.qr-image;
                    height: self.width;
                    image-rendering: pixelated;
                }
                Text {
                    text: "Отсканируйте камерой другого устройства или в DUORAY: «+» → «QR-код».";
                    font-size: Theme.fs-caption;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }
        }
    }
    if root.identity-open: IdentitySheet {
        bottom-inset: root.bottom;
        close => {
            root.identity-open = false;
        }
    }
    if AppState.report-open: ReportSheet {
        top-inset: root.top;
        close => {
            AppState.report-open = false;
        }
    }
    if AppState.consent-open: ConsentSheet { }
    if root.confirm-remove: ConfirmSheet {
        title: "Удалить подписку «" + AppState.header-title + "»?";
        action: "Удалить";
        confirmed => {
            Actions.remove-subscription();
        }
        close => {
            root.confirm-remove = false;
        }
    }
}
