<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Slint draws edge to edge and keeps clear of the bars (safe-area-insets);
         the window background only shows before the first frame. -->
    <style name="Theme.Duoray" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowBackground">#141218</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
