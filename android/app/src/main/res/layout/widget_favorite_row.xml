<?xml version="1.0" encoding="utf-8"?>
<!-- One pinned server in «Избранное». Colors: Widgets.kt. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="48dp"
    android:paddingTop="4dp">

    <ImageView
        android:id="@+id/row_bg"
        android:tint="#FF4A4458"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_pill" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <TextView
            android:id="@+id/row_flag"
            android:text="🇫🇮"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:importantForAccessibility="no"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/row_name"
            android:text="Финляндия"
            android:textColor="#FFE8DEF8"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/row_check"
            android:tint="#FF381E72"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_check" />
    </LinearLayout>
</FrameLayout>
